  "pattern_code": {
    "outer": "step_x = 22.0000\nstep_y = 22.0000\nr      = 50.0000\nexcl   = 3.0000\nflat_y = -47.2857\n\nn_x = int(r / step_x) + 2\nn_y = int(r / step_y) + 2\nresult = []\nfor i in range(-n_x, n_x + 1):\n    for j in range(-n_y, n_y + 1):\n        x = i * step_x\n        y = j * step_y\n        if math.sqrt(x*x + y*y) + excl <= r and y >= flat_y + excl:\n            result.append((x, y))\n",
    "m15": "r = 47.5\npoints=[]\ndelAng = 15\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])",
    "m30": "r = 47.5\npoints=[]\ndelAng = 30\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])",
    "m45": "r = 47.5\npoints=[]\ndelAng = 45\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n",
    "m60": "r = 47.5\npoints=[]\ndelAng = 60\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n",
    "m75": "r = 47.5\npoints=[]\ndelAng = 75\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n",
    "m90": "r = 47.5\npoints=[]\ndelAng = 10\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n",
    "m105": "r = 47.5\npoints=[]\ndelAng = 25\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n",
    "m120": "r = 47.5\npoints=[]\ndelAng = 40\nfor a in range(4):\n\tpoints.append([r * math.cos((a/2 + delAng/180) * math.pi), r * math.sin((a/2 + delAng/180) * math.pi)])\n"
  },
